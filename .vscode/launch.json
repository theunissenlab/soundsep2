{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: sep run (conda env)",
      "type": "python",
      "request": "launch",
      "python": "/opt/miniconda3/envs/sep/bin/python",
      "program": "/opt/miniconda3/envs/sep/bin/sep",
      "args": [
        "run"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {}
    },
    {
      "name": "Python Debugger: Python File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}"
    },
    {
      "name": "Python: Attach by Process ID",
      "type": "debugpy",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "justMyCode": false
    },
    {
      "name": "Python: Attach to Port 5678",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "justMyCode": false
    }
  ]
}